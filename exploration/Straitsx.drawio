            <mxPoint x="820.0" y="2020" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v123" value="&lt;b&gt;releaseNonce → retry with a fresh nonce&lt;/b&gt;&lt;br&gt;permitted ONLY before a signature exists (signer error or write conflict)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=11;fillColor=#FFF8E1;strokeColor=#C8A415;fontColor=#5C4708;" vertex="1" parent="1">
          <mxGeometry x="40" y="2020" width="480" height="82" as="geometry" />
