          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="v129" value="&lt;b&gt;signed&lt;/b&gt; { PAYMENT-SIGNATURE header, nonce } &amp;nbsp;+ recordDecision" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;fillColor=#C8E6C9;strokeColor=#1B5E20;fontColor=#0B2E10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="560" y="2264" width="520" height="82" as="geometry" />
        </mxCell>
        <mxCell id="e130" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32;fontColor=#2E7D32;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820.0" y="2224" as="sourcePoint" />
            <mxPoint x="820.0" y="2264" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v131" value="&lt;b&gt;After a signature exists, the intent is terminal.&lt;/b&gt; There is no release. If the cardapi retry fails or settlement times out after signing, rotate to a fresh intentId — never reuse the intent or the nonce, or two live authorizations for the same amount could both settle." style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=11;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#7A1414;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="2396" width="1180" height="96" as="geometry" />
        </mxCell>
      </root>
