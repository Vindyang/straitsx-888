        <mxCell id="v16" value="UNTRUSTED ZONE — human, browser, agent, merchant page, and the x402 challenge itself" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;dashed=1;dashPattern=8 6;fillColor=#F7F8FA;strokeColor=#B9C0CC;fontColor=#5B6472;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="2160" height="420" as="geometry" />
        </mxCell>
        <mxCell id="v17" value="DECISION PLANE — our services: structured data in, decisions out, never instructions" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;dashed=1;dashPattern=8 6;fillColor=#F7F8FA;strokeColor=#B9C0CC;fontColor=#5B6472;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="2160" height="490" as="geometry" />
        </mxCell>
        <mxCell id="v18" value="KEY CUSTODY — network-isolated; policy-service is the only permitted caller" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;dashed=1;dashPattern=8 6;fillColor=#F7F8FA;strokeColor=#B9C0CC;fontColor=#5B6472;" vertex="1" parent="1">
          <mxGeometry x="40" y="1200" width="2160" height="280" as="geometry" />
        </mxCell>
        <mxCell id="v19" value="ON-CHAIN &amp; EXTERNAL SETTLEMENT — settlement precedes issuance; the one irreversible step" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;dashed=1;dashPattern=8 6;fillColor=#F7F8FA;strokeColor=#B9C0CC;fontColor=#5B6472;" vertex="1" parent="1">
          <mxGeometry x="40" y="1530" width="2160" height="320" as="geometry" />
        </mxCell>
        <mxCell id="e20" value="" style="html=1;endArrow=none;strokeWidth=3;dashed=1;dashPattern=10 6;strokeColor=#C62828;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="40" y="628" as="sourcePoint" />
            <mxPoint x="2200" y="628" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v21" value="TRUST BOUNDARY — everything above is untrusted input, including the challenge" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontSize=12;fontStyle=1;fontColor=#C62828;align=right;" vertex="1" parent="1">
          <mxGeometry x="1240" y="606" width="960" height="22" as="geometry" />
        </mxCell>
        <mxCell id="v22" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;strokeColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="95" y="250" width="40" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v23" value="Human
mandate owner" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="318" width="130" height="34" as="geometry" />
        </mxCell>
        <mxCell id="v24" value="&lt;b&gt;dashboard&lt;/b&gt; &amp;nbsp;[C]&lt;br&gt;&lt;i&gt;Next.js&lt;/i&gt;&lt;br&gt;&lt;br&gt;mandate creation form&lt;br&gt;running window spend&lt;br&gt;receipt view · revoke button&lt;br&gt;refusal panel (failing check)&lt;br&gt;escalation screen — renders an&lt;br&gt;&lt;b&gt;independent fetch&lt;/b&gt; of the checkout page" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fillColor=#FFF3E0;strokeColor=#EF6C00;fontColor=#5A2C00;" vertex="1" parent="1">
          <mxGeometry x="200" y="250" width="270" height="170" as="geometry" />
        </mxCell>
        <mxCell id="v25" value="&lt;b&gt;agent-orchestrator&lt;/b&gt; &amp;nbsp;[C]&lt;br&gt;&lt;i&gt;long-running process&lt;/i&gt;&lt;br&gt;&lt;br&gt;discovery via Playwright · orchestration&lt;br&gt;&lt;b&gt;assertCheckoutDomain()&lt;/b&gt; — refuse to fill&lt;br&gt;&lt;b&gt;captureSpendAttestation()&lt;/b&gt; — spend leg&lt;br&gt;&lt;br&gt;&lt;i&gt;holds no key · makes no decisions ·&lt;br&gt;must not be able to reach the signer&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fillColor=#FFF3E0;strokeColor=#EF6C00;fontColor=#5A2C00;" vertex="1" parent="1">
          <mxGeometry x="570" y="250" width="340" height="200" as="geometry" />
        </mxCell>
        <mxCell id="v26" value="&lt;b&gt;Merchant site / product page&lt;/b&gt;&lt;br&gt;&lt;i&gt;external, untrusted&lt;/i&gt;&lt;br&gt;&lt;br&gt;prompt-injection fixture&lt;br&gt;(poisoned page — build it day one)&lt;br&gt;&lt;br&gt;&lt;i&gt;every byte is input,&lt;br&gt;never instruction&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#7A1414;" vertex="1" parent="1">
          <mxGeometry x="1010" y="250" width="290" height="200" as="geometry" />
        </mxCell>
        <mxCell id="v27" value="&lt;b&gt;card-gateway&lt;/b&gt; &amp;nbsp;[C]&lt;br&gt;&lt;i&gt;MCP SSE client&lt;/i&gt;&lt;br&gt;&lt;br&gt;endpoint event · 202-then-stream&lt;br&gt;validates name 2–26, amount 5–30&lt;br&gt;&lt;br&gt;&lt;i&gt;no signing · no policy · no storage&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fillColor=#FFF3E0;strokeColor=#EF6C00;fontColor=#5A2C00;" vertex="1" parent="1">
          <mxGeometry x="1390" y="250" width="290" height="170" as="geometry" />
        </mxCell>
        <mxCell id="v28" value="&lt;b&gt;StraitsX card MCP&lt;/b&gt;&lt;br&gt;&lt;i&gt;straitsx-card-mcp-sandbox 2.0.0&lt;/i&gt;&lt;br&gt;https://card.straitsx.ai/sandbox/sse&lt;br&gt;&lt;br&gt;get_card_sandbox&lt;br&gt;view_card_sandbox&lt;br&gt;&lt;i&gt;tools only — no webhook, no RHA&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fillColor=#ECEFF1;strokeColor=#546E7A;fontColor=#28353C;" vertex="1" parent="1">
          <mxGeometry x="1760" y="250" width="290" height="170" as="geometry" />
        </mxCell>
        <mxCell id="v29" value="&lt;b&gt;ledger-service&lt;/b&gt; &amp;nbsp;[B]&lt;br&gt;&lt;i&gt;append-only system of record&lt;/i&gt;&lt;br&gt;&lt;br&gt;createIntent · attachChallenge&lt;br&gt;reserveNonce / releaseNonce&lt;br&gt;getWindowUsage · recordDecision&lt;br&gt;recordSpend · get/putPolicy&lt;br&gt;&lt;br&gt;&lt;i&gt;intents immutable once written&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#14401B;" vertex="1" parent="1">
          <mxGeometry x="180" y="720" width="290" height="200" as="geometry" />
        </mxCell>
        <mxCell id="v30" value="&lt;b&gt;policy-service&lt;/b&gt; &amp;nbsp;[B]&lt;br&gt;&lt;b&gt;THE DECISION POINT — this is the project&lt;/b&gt;&lt;br&gt;&lt;br&gt;POST /payment/request&lt;br&gt;precondition → checks 1–8 → gate 9&lt;br&gt;→ reserveNonce → sign → recordDecision&lt;br&gt;&lt;br&gt;returns &lt;b&gt;signed&lt;/b&gt; | &lt;b&gt;refused&lt;/b&gt; | &lt;b&gt;escalated&lt;/b&gt;&lt;br&gt;&lt;i&gt;every outcome logged, refusals included&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#14401B;" vertex="1" parent="1">
          <mxGeometry x="570" y="720" width="340" height="200" as="geometry" />
        </mxCell>
        <mxCell id="v31" value="&lt;b&gt;semantic matcher&lt;/b&gt; (LLM) &amp;nbsp;[B]&lt;br&gt;&lt;i&gt;gate 9 — triage only&lt;/i&gt;&lt;br&gt;&lt;br&gt;structured field-by-field compare:&lt;br&gt;title · sku · price · merchantDomain&lt;br&gt;&lt;br&gt;&lt;i&gt;outputs only &lt;b&gt;match&lt;/b&gt; or &lt;b&gt;uncertain&lt;/b&gt;;&lt;br&gt;it can never say “mismatch → sign”&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#14401B;" vertex="1" parent="1">
          <mxGeometry x="1010" y="720" width="290" height="200" as="geometry" />
        </mxCell>
        <mxCell id="v32" value="&lt;b&gt;chain-gateway&lt;/b&gt; &amp;nbsp;[A]&lt;br&gt;&lt;i&gt;the ONLY component that talks to an RPC node&lt;/i&gt;&lt;br&gt;&lt;br&gt;getMandate · getTokenConstants&lt;br&gt;confirmSettlement · buildRevokeTx&lt;br&gt;&lt;br&gt;&lt;i&gt;owns the decimals / EIP-712 domain risk&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D3C61;" vertex="1" parent="1">
          <mxGeometry x="180" y="960" width="290" height="160" as="geometry" />
        </mxCell>
        <mxCell id="v33" value="&lt;b&gt;Escalation policy&lt;/b&gt;&lt;br&gt;TTL 5 min → &lt;b&gt;auto-deny&lt;/b&gt; (never hang)&lt;br&gt;approve once | approve merchant for window&lt;br&gt;&lt;br&gt;&lt;i&gt;fires only on check 6 or gate 9 —&lt;br&gt;if every purchase escalates,&lt;br&gt;the mandate is misconfigured&lt;/i&gt;" style="shape=note;size=14;fillColor=#FFF8E1;strokeColor=#C8A415;fontColor=#5C4708;align=left;verticalAlign=top;whiteSpace=wrap;html=1;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="960" width="290" height="160" as="geometry" />
        </mxCell>
        <mxCell id="v34" value="&lt;b&gt;THE EIGHT CHECKS&lt;/b&gt; — deterministic, pure functions, never LLM-judged&lt;br&gt;&lt;br&gt;&lt;b&gt;0&lt;/b&gt; &amp;nbsp;precondition — intent anchored for this requestId (cheapest refusal)&lt;br&gt;&lt;b&gt;1&lt;/b&gt; &amp;nbsp;mandate live — exists, revoked == false on-chain, now &amp;lt; expiresAt&lt;br&gt;&lt;b&gt;2&lt;/b&gt; &amp;nbsp;policy hash match — loaded body hashes to what the registry says&lt;br&gt;&lt;b&gt;3&lt;/b&gt; &amp;nbsp;chain and asset pinned — chainId and token address exact&lt;br&gt;&lt;b&gt;4&lt;/b&gt; &amp;nbsp;&lt;b&gt;recipient pinned — challenge.payTo == settlementRecipient&lt;/b&gt; ★&lt;br&gt;&lt;b&gt;5&lt;/b&gt; &amp;nbsp;amount in bounds 5 ≤ amt ≤ min(maxPerCard, 30) + consistency&lt;br&gt;&lt;b&gt;6&lt;/b&gt; &amp;nbsp;window budget — spend within maxPerWindow and at most ONE card (maxCardsPerWindow = 1)&lt;br&gt;&lt;b&gt;7&lt;/b&gt; &amp;nbsp;validity sane — validBefore − validAfter ≤ measured max&lt;br&gt;&lt;b&gt;8&lt;/b&gt; &amp;nbsp;intent bound — record created BEFORE the challenge arrived&lt;br&gt;&lt;br&gt;&lt;b&gt;gate 9&lt;/b&gt; — intent match (advisory) → escalate to the human on doubt&lt;br&gt;&lt;br&gt;&lt;i&gt;Failure direction is the deliverable: 1–5, 7, 8 → refused; 6 and 9 → escalated; nothing degrades toward money moving.&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA4B2;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1390" y="720" width="660" height="400" as="geometry" />
        </mxCell>
        <mxCell id="v35" value="&lt;b&gt;Two secrets, not one&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;signing key&lt;/b&gt; — never in the agent&#x27;s&lt;br&gt;reach (KMS + network isolation)&lt;br&gt;&lt;br&gt;&lt;b&gt;card PAN&lt;/b&gt; — in the agent&#x27;s browser&lt;br&gt;for seconds; amount-bound and&lt;br&gt;one-time, but &lt;b&gt;not merchant-bound&lt;/b&gt;" style="shape=note;size=14;fillColor=#FFF8E1;strokeColor=#C8A415;fontColor=#5C4708;align=left;verticalAlign=top;whiteSpace=wrap;html=1;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="1250" width="290" height="180" as="geometry" />
        </mxCell>
        <mxCell id="v36" value="&lt;b&gt;signer-service&lt;/b&gt; &amp;nbsp;[A]&lt;br&gt;&lt;i&gt;sole key holder · deliberately dumb&lt;/i&gt;&lt;br&gt;&lt;br&gt;sign(typedData, requestId) → { header, nonce }&lt;br&gt;builds EIP-3009 TransferWithAuthorization&lt;br&gt;&lt;br&gt;&lt;b&gt;hard-invariant rail:&lt;/b&gt; refuses any recipient&lt;br&gt;not pinned or value &amp;gt; hardMaxTotal" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D3C61;" vertex="1" parent="1">
          <mxGeometry x="570" y="1250" width="340" height="180" as="geometry" />
        </mxCell>
        <mxCell id="v37" value="&lt;b&gt;AWS KMS&lt;/b&gt;&lt;br&gt;&lt;i&gt;asymmetric secp256k1&lt;/i&gt;&lt;br&gt;&lt;br&gt;KMS:Sign — signer role only&lt;br&gt;&lt;br&gt;&lt;i&gt;key material never leaves KMS;&lt;br&gt;only the key id is in env.&lt;br&gt;KMS is not substitutable.&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D3C61;" vertex="1" parent="1">
          <mxGeometry x="1010" y="1250" width="290" height="180" as="geometry" />
        </mxCell>
        <mxCell id="v38" value="&lt;b&gt;LOAD-BEARING RULE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;signer-service accepts calls from policy-service and nothing else.&lt;/b&gt;&lt;br&gt;Enforced at the network layer, not by convention, and proven by a CI probe test that asserts agent-orchestrator → signer-service is &lt;b&gt;connection refused&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Split authority: policy-service and signer-service run under different IAM roles, so compromising one does not grant the other." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#7A1414;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1250" width="660" height="180" as="geometry" />
        </mxCell>
        <mxCell id="v39" value="&lt;b&gt;mandate-registry&lt;/b&gt; &amp;nbsp;[A]&lt;br&gt;&lt;i&gt;Solidity (Foundry) · Fuji 43113&lt;/i&gt;&lt;br&gt;&lt;br&gt;mandateId → owner, policyHash,&lt;br&gt;expiresAt, revoked&lt;br&gt;&lt;br&gt;&lt;i&gt;revoke: owner only, NO timelock&lt;br&gt;— effective within a block&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D3C61;" vertex="1" parent="1">
          <mxGeometry x="180" y="1580" width="290" height="180" as="geometry" />
        </mxCell>
        <mxCell id="v40" value="&lt;b&gt;XSGD&lt;/b&gt; (Avalanche)&lt;br&gt;&lt;i&gt;EIP-3009 TransferWithAuthorization&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;decimals = 6, NOT 18&lt;/b&gt; (verified on 43114)&lt;br&gt;EIP-712 domain name/version from verified&lt;br&gt;source — version() reverts on-chain&lt;br&gt;&lt;br&gt;&lt;i&gt;nonce enforces single use (replay)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;fillColor=#ECEFF1;strokeColor=#546E7A;fontColor=#28353C;" vertex="1" parent="1">
          <mxGeometry x="570" y="1580" width="340" height="180" as="geometry" />
        </mxCell>
        <mxCell id="v41" value="&lt;b&gt;The one irreversible step&lt;/b&gt;&lt;br&gt;&lt;br&gt;Settlement PRECEDES issuance.&lt;br&gt;Pay first, receive card second.&lt;br&gt;&lt;br&gt;Before it, refusing costs nothing.&lt;br&gt;After it, XSGD has moved — so every&lt;br&gt;check lives in policy-service and&lt;br&gt;none in the signer." style="shape=note;size=14;fillColor=#FFF8E1;strokeColor=#C8A415;fontColor=#5C4708;align=left;verticalAlign=top;whiteSpace=wrap;html=1;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1010" y="1580" width="290" height="180" as="geometry" />
        </mxCell>
