  <diagram id="contracts---coverage" name="Contracts &amp; coverage">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2260" pageHeight="2340" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v268" value="Contracts, coverage, and owned boundaries" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontSize=24;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="40" y="26" width="1400" height="34" as="geometry" />
        </mxCell>
        <mxCell id="v269" value="What the mandate holds, what the receipt proves, which attacks are covered, and what is honestly still open · docs/execution_plan.md §7, §12, §14, §19" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontSize=12;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1800" height="22" as="geometry" />
        </mxCell>
        <mxCell id="v270" value="&lt;b style=&#x27;font-family:Helvetica;font-size:13px&#x27;&gt;Mandate &amp;amp; policy schema (§7)&lt;/b&gt;&lt;br&gt;&lt;br&gt;type Mandate = {&lt;br&gt;&amp;nbsp;&amp;nbsp;mandateId:              string;&lt;br&gt;&amp;nbsp;&amp;nbsp;owner:                  Address;   &lt;span style=&#x27;color:#6B7280&#x27;&gt;// only address that can revoke&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;agentId:                string;&lt;br&gt;&amp;nbsp;&amp;nbsp;chainId:                43113 | 43114;&lt;br&gt;&amp;nbsp;&amp;nbsp;asset:                  Address;   &lt;span style=&#x27;color:#6B7280&#x27;&gt;// pinned XSGD contract&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;settlementRecipient:    Address;   &lt;span style=&#x27;color:#6B7280&#x27;&gt;// pinned StraitsX address&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;maxPerCard:             bigint;    &lt;span style=&#x27;color:#6B7280&#x27;&gt;// &amp;lt;= 30 SGD&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;maxPerWindow:           bigint;&lt;br&gt;&amp;nbsp;&amp;nbsp;maxCardsPerWindow:      number = 1; &lt;span style=&#x27;color:#6B7280&#x27;&gt;// one card per window — policy decision&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;windowSeconds:          number;&lt;br&gt;&amp;nbsp;&amp;nbsp;maxAuthValiditySeconds: number;    &lt;span style=&#x27;color:#6B7280&#x27;&gt;// MEASURED at checkpoint 2&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;expiresAt:              number;&lt;br&gt;&amp;nbsp;&amp;nbsp;revoked:                boolean;&lt;br&gt;&amp;nbsp;&amp;nbsp;intentConstraint:       string;    &lt;span style=&#x27;color:#6B7280&#x27;&gt;// advisory, human-written&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;merchantAllowlist:      string[];  &lt;span style=&#x27;color:#6B7280&#x27;&gt;// advisory, optional&lt;/span&gt;&lt;br&gt;};&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-family:Helvetica&#x27;&gt;&lt;b&gt;On-chain:&lt;/b&gt; mandateId → owner, policyHash, expiresAt, revoked&lt;br&gt;&lt;b&gt;Off-chain:&lt;/b&gt; the full body, window counters, card counts&lt;br&gt;&lt;br&gt;policyHash is computed over the &lt;b&gt;full body including intentConstraint and merchantAllowlist&lt;/b&gt;, so tampering with the constraint is caught by check 2. hashPolicy lives in /packages/contracts and nobody reimplements it — if the dashboard serialises differently from policy-service, check 2 fails permanently and it will look like a contract bug for hours.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA4B2;fontColor=#1F2937;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="1060" height="610" as="geometry" />
        </mxCell>
        <mxCell id="v271" value="&lt;b style=&#x27;font-family:Helvetica;font-size:13px&#x27;&gt;Verifiable receipt (§12) — two legs, two proof strengths&lt;/b&gt;&lt;br&gt;&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;requestId&quot;: &quot;…&quot;,  &quot;mandateId&quot;: &quot;…&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;intent&quot;: &quot;verbatim human instruction&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;challenge&quot;: { &quot;payTo&quot;, &quot;asset&quot;, &quot;chainId&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;amount&quot;, &quot;validAfter&quot;, &quot;validBefore&quot; },&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;nonce&quot;: &quot;0x…&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;settlementTx&quot;: &quot;0x…&quot;,  &quot;blockNumber&quot;: 0,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;cardOpaqueId&quot;: &quot;…&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;decision&quot;: &quot;signed&quot;,  &quot;decidedAt&quot;: &quot;ISO-8601&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;spendLeg&quot;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;status&quot;: &quot;observed | pending | absent&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;merchantDomain&quot;: &quot;…&quot;, &quot;orderTotal&quot;: &quot;…&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;itemSku&quot;: &quot;…&quot;, &quot;observedAt&quot;: &quot;ISO-8601&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;proof&quot;: &quot;none | merchant-signed-attestation&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;}&lt;br&gt;}&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;font-family:Helvetica&#x27;&gt;&lt;b&gt;Funding leg&lt;/b&gt; (human intent → on-chain settlement) — cryptographically verifiable.&lt;br&gt;&lt;b&gt;Spend leg&lt;/b&gt; (card issued → card used) — &lt;b&gt;observational only&lt;/b&gt;. proof stays &quot;none&quot; until a merchant-signed attestation exists (Visa TAP / Mastercard KYA / ERC-8004). Until then we &lt;i&gt;prove&lt;/i&gt; the funding and &lt;i&gt;observe&lt;/i&gt; the spending.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA4B2;fontColor=#1F2937;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="1060" height="700" as="geometry" />
        </mxCell>
        <mxCell id="v272" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Attack coverage (§14)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Injected page redirects payment &amp;nbsp;→&amp;nbsp; &lt;b&gt;check 4&lt;/b&gt;&lt;br&gt;Injected page inflates the amount &amp;nbsp;→&amp;nbsp; &lt;b&gt;check 5&lt;/b&gt;&lt;br&gt;Compromised agent loops to drain &amp;nbsp;→&amp;nbsp; &lt;b&gt;check 6&lt;/b&gt;&lt;br&gt;Stolen signature replayed &amp;nbsp;→&amp;nbsp; &lt;b&gt;EIP-3009 nonce, enforced by the token&lt;/b&gt;&lt;br&gt;Human spots something wrong &amp;nbsp;→&amp;nbsp; &lt;b&gt;on-chain revoke, then check 1 within a block&lt;/b&gt;&lt;br&gt;Challenge names a different token &amp;nbsp;→&amp;nbsp; &lt;b&gt;check 3&lt;/b&gt;&lt;br&gt;Long-lived authorization left usable &amp;nbsp;→&amp;nbsp; &lt;b&gt;check 7&lt;/b&gt;&lt;br&gt;Signature with no traceable instruction &amp;nbsp;→&amp;nbsp; &lt;b&gt;check 8 (precondition)&lt;/b&gt;&lt;br&gt;Agent resolves the wrong legitimate item &amp;nbsp;→&amp;nbsp; &lt;b&gt;gate 9&lt;/b&gt; &lt;i&gt;— only if the agent is honest&lt;/i&gt;&lt;br&gt;Card used at an unexpected merchant &amp;nbsp;→&amp;nbsp; &lt;b&gt;assertCheckoutDomain&lt;/b&gt; &lt;i&gt;— only if the agent is honest&lt;/i&gt;&lt;br&gt;Compromised policy-service asks for an out-of-envelope signature &amp;nbsp;→&amp;nbsp; &lt;b&gt;signer hard-invariant rail&lt;/b&gt;&lt;br&gt;Escalation left unanswered &amp;nbsp;→&amp;nbsp; &lt;b&gt;TTL auto-deny&lt;/b&gt;&lt;br&gt;Matcher fooled by adversarial phrasing &amp;nbsp;→&amp;nbsp; &lt;b&gt;escalate-only outputs&lt;/b&gt; &lt;i&gt;— degrades to interruptions, never to money moving&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&#x27;color:#B71C1C&#x27;&gt;NOT stopped:&lt;/b&gt; the agent buying the wrong legitimate item through the allowed flow &lt;i&gt;while lying about what it resolved&lt;/i&gt;, and the same agent &lt;i&gt;exfiltrating the PAN&lt;/i&gt; to use the card elsewhere. The spend leg is observed, not cryptographically bound." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA4B2;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="1140" y="130" width="1080" height="560" as="geometry" />
        </mxCell>
        <mxCell id="v273" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Owned boundaries — what we do NOT solve (§1)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1 · We cannot cryptographically bind the merchant.&lt;/b&gt; The issuance API takes no merchant parameter and the card is amount-bound only. The allowlist is advisory; assertCheckoutDomain is the only enforcement point we own after issuance.&lt;br&gt;&lt;br&gt;&lt;b&gt;2 · We cannot prove the item is legitimate.&lt;/b&gt; Intent-scoping is heuristic + human-in-the-loop, not proof. It makes the wrong-item attack visible and gated, not impossible.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 · The security claim is a deployment property, not math.&lt;/b&gt; &quot;The agent never holds the key&quot; is true only if the network isolation around signer-service is correct — hence the probe test.&lt;br&gt;&lt;br&gt;&lt;b&gt;Common thread (§12b):&lt;/b&gt; we cannot make these strong, only &lt;b&gt;fail-closed&lt;/b&gt;. Each one degrades toward auto-deny, refuse-to-sign, or escalate — never toward money moving." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA4B2;fontColor=#1F2937;fillColor=#FFF8E1;strokeColor=#C8A415;fontColor=#5C4708;" vertex="1" parent="1">
          <mxGeometry x="1140" y="720" width="1080" height="400" as="geometry" />
        </mxCell>
        <mxCell id="v274" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Still open — blockers, not design work (§19.4)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Fuji paying asset — RESOLVED by staging.&lt;/b&gt; No public testnet XSGD exists; instead we deploy &lt;b&gt;TSGD&lt;/b&gt; (mock XSGD, same EIP-3009 interface) on Fuji 43113 and mint freely; faucet AVAX covers gas. Production swaps the address to real XSGD (43114, 0xb2F85b7AB3c2b6f62DF06dE6aE7D09c010a5096E).&lt;br&gt;&lt;br&gt;&lt;b&gt;EIP-712 version string — OPEN.&lt;/b&gt; version() reverts, no EIP-5267, no DOMAIN_SEPARATOR — must come from verified source or docs, never assumed.&lt;br&gt;&lt;br&gt;&lt;b&gt;Production endpoint permission — OPEN.&lt;/b&gt; Reachable is not the same as cleared; minting there spends real money.&lt;br&gt;&lt;br&gt;&lt;b&gt;Fuji EIP-712 domain values — OPEN.&lt;/b&gt; Must be read from the &lt;i&gt;Fuji&lt;/i&gt; TSGD contract once its address is known; production values are read from the real 43114 XSGD contract, never inherited.&lt;br&gt;&lt;br&gt;&lt;b&gt;Sandbox MCP reachability — OPEN.&lt;/b&gt; The StraitsX sandbox MCP needs NO auth (verified live: initialize + tools/list succeed bare), but card.straitsx.ai is currently blocked from this machine by a FortiGuard Web Filter (403, &quot;Web Filter Violation&quot;); whitelist the domain or use a clear network before Stage A card generation can run here. Rep provisioning still needed for the real simulate_transactions API (client_id/secret, issuing plan, RHA/webhook registration)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA4B2;fontColor=#1F2937;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#7A1414;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1150" width="1080" height="320" as="geometry" />
        </mxCell>
        <mxCell id="v275" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Build order (§16) and demo runs (§21)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Stub-first hour&lt;/b&gt; — every service ships a stub with the real signature and a fake body, so integration is a swap, not a merge.&lt;br&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; registry live, dashboard creates a mandate &amp;nbsp;·&amp;nbsp; &lt;b&gt;2&lt;/b&gt; first real signature accepted by cardapi — &lt;b&gt;highest risk&lt;/b&gt;, and where maxAuthValiditySeconds gets measured &amp;nbsp;·&amp;nbsp; &lt;b&gt;3&lt;/b&gt; one clean run with policy-service in path &amp;nbsp;·&amp;nbsp; &lt;b&gt;4&lt;/b&gt; one refusal: poisoned page refused on check 4 — &lt;b&gt;at this point the project is presentable&lt;/b&gt; &amp;nbsp;·&amp;nbsp; &lt;b&gt;5&lt;/b&gt; &lt;i&gt;(stretch)&lt;/i&gt; intent-match escalation &amp;nbsp;·&amp;nbsp; &lt;b&gt;6&lt;/b&gt; &lt;i&gt;(stretch)&lt;/i&gt; assertCheckoutDomain + recordSpend&lt;br&gt;&lt;br&gt;&lt;b&gt;Run 1 clean&lt;/b&gt; — instruction → discovery → card → approve → sign → settle → one-time iframe → checkout → receipt with a real tx hash.&lt;br&gt;&lt;b&gt;Run 2 poisoned (never cut)&lt;/b&gt; — the agent is injected to request a different payment; policy refuses on check 4; nothing signed, no money moved.&lt;br&gt;&lt;b&gt;Run 3 revoke (cut first)&lt;/b&gt; — human revokes on-chain; the next purchase fails check 1 within a block, with no coordination between agent and signer.&lt;br&gt;&lt;b&gt;Run 4 intent escalation (stretch)&lt;/b&gt; · &lt;b&gt;Run 5 spend-leg reconciliation (stretch)&lt;/b&gt; — honest that proof = &quot;none&quot;.&lt;br&gt;&lt;br&gt;&lt;i&gt;Build the poisoned-page fixture on day one, not the last night. Record a fallback video.&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA4B2;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="1510" width="2180" height="300" as="geometry" />
        </mxCell>
        <mxCell id="v276" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Staged demo model (§21b) — how the token and merchant change per stage&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Stage A (test, sandbox):&lt;/b&gt; paying asset = &lt;b&gt;TSGD&lt;/b&gt; (mock XSGD, same EIP-3009 interface) on Fuji 43113, freely minted; merchant = &lt;b&gt;our own mock resource server&lt;/b&gt; exposing &lt;b&gt;both rails&lt;/b&gt; — x402 (402 + payment-required challenge) &lt;i&gt;and&lt;/i&gt; UCP (/.well-known/ucp → cart/checkout whose payment handler issues the same TSGD challenge); &lt;b&gt;card generation is REAL&lt;/b&gt; — StraitsX sandbox MCP get_card_sandbox returns a real cardapi URL + iframe card view; only the &lt;b&gt;issuer AUTH leg is SIMULATED&lt;/b&gt; (local RHA stand-in mirroring StraitsX simulate-transaction contract — approved|declined, response codes), swapped to the real simulate_transactions API once the rep provisions it. Money movement: SGD → mint TSGD (simulated on-ramp) → EIP-3009 on-chain transfer → burn TSGD → SGD (simulated redemption, 1:1); TSGD minted once per purchase, burned once. Real mpp.dev catalog is mainnet + USDC-only, so it is exercised only in production.&lt;br&gt;&lt;br&gt;&lt;b&gt;Stage B (production swap):&lt;/b&gt; TSGD → &lt;b&gt;real XSGD&lt;/b&gt; (Avalanche 43114, 0xb2F85b7AB3c2b6f62DF06dE6aE7D09c010a5096E); token moves buyer → merchant on-chain; the &lt;b&gt;XSGD → SGD → card-issuer redemption leg is executed by StraitsX&lt;/b&gt; (MAS-licensed), not by us — our card purchase itself remains the demo. Order of implementation: &lt;b&gt;x402 first&lt;/b&gt; (native rail, self-testable), &lt;b&gt;UCP later&lt;/b&gt; (interop path to the merchant web)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA4B2;fontColor=#1F2937;fillColor=#E8F0FE;strokeColor=#4285F4;fontColor=#174EA6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1830" width="2180" height="300" as="geometry" />
        </mxCell>
        <mxCell id="v277" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Real-time transparency + audit (&lt;span style=&#x27;color:#0D652D&#x27;&gt;DONE in ledger-service&lt;/span&gt;)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Every ledger mutation is broadcast live as an append-only SSE event — &lt;b&gt;GET /ledger/events&lt;/b&gt;: a fresh connection gets a &lt;b&gt;snapshot&lt;/b&gt; of the whole ledger (same shape as GET /intents), then &lt;b&gt;append&lt;/b&gt; events as each step lands; 15s heartbeat. Event kinds: intent.created → challenge.attached → nonce.reserved → decision.recorded (refusals + escalations included — every outcome is visible) → settlement.recorded → spend.recorded → capture.recorded, plus policy.put, escalation.created/resolved, standing_approval.set.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ledger page (live)&lt;/b&gt; — the dashboard proxies the stream (GET /api/ledger/events) and renders each step in real time; &lt;b&gt;History page (audit)&lt;/b&gt; — GET /intents append-only, newest first, read-only view + per-purchase GET /receipt/:requestId. Append-only by design: records are never rewritten or deleted, only extended." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=11;fillColor=#FFFFFF;strokeColor=#9AA4B2;fontColor=#1F2937;fillColor=#E6F4EA;strokeColor=#137333;fontColor=#0D652D;" vertex="1" parent="1">
          <mxGeometry x="40" y="2150" width="2180" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
