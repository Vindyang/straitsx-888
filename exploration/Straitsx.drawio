        <mxCell id="v117" value="&lt;b&gt;gate 9&lt;/b&gt; — semantic matcher: resolvedItem vs intentConstraint, merchantDomain vs merchantAllowlist" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;fillColor=#FFF3E0;strokeColor=#EF6C00;fontColor=#5A2C00;" vertex="1" parent="1">
