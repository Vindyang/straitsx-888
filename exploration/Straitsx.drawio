          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="v121" value="&lt;b&gt;reserveNonce(requestId, nonce)&lt;/b&gt; — conditional write; a second reservation MUST fail" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;fillColor=#FFFFFF;strokeColor=#9AA4B2;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="560" y="2020" width="520" height="82" as="geometry" />
