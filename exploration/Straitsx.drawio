        <mxCell id="e124" value="escalate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#B26A00;fontColor=#B26A00;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v121" target="v123">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="v125" value="&lt;b&gt;signer-service.sign&lt;/b&gt; — hard-invariant rail: recipient pinned, value ≤ hardMaxTotal" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#14401B;" vertex="1" parent="1">
          <mxGeometry x="560" y="2142" width="520" height="82" as="geometry" />
        </mxCell>
        <mxCell id="e126" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2E7D32;fontColor=#2E7D32;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820.0" y="2102" as="sourcePoint" />
            <mxPoint x="820.0" y="2142" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v127" value="&lt;b&gt;REFUSED by the signer&lt;/b&gt;&lt;br&gt;a fixed invariant, not policy evaluation — even a compromised policy-service cannot push past the envelope" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=11;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#7A1414;" vertex="1" parent="1">
