        <mxCell id="v127" value="&lt;b&gt;REFUSED by the signer&lt;/b&gt;&lt;br&gt;a fixed invariant, not policy evaluation — even a compromised policy-service cannot push past the envelope" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fontSize=11;fillColor=#FFEBEE;strokeColor=#C62828;fontColor=#7A1414;" vertex="1" parent="1">
