        <mxCell id="b7" value="someone else&#x27;s — stub it, mock it, do not build it" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="1324" y="70" width="360" height="18" as="geometry" />
