        <mxCell id="c1" value="Module C — Agent &amp; Surfaces" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#5A2C00;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Owns: agent-orchestrator · card-gateway · dashboard&#160;&#160;·&#160;&#160;everything here sits on the untrusted side of the boundary&#160;&#160;·&#160;&#160;holds no key, makes no decisions&#160;&#160;·&#160;&#160;split from Straitsx.drawio" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1200" height="22" as="geometry" />
