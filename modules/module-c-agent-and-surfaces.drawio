  <diagram id="module-c" name="Module C — Agent &amp; Surfaces">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="1080" math="0" shadow="0">
