# Copy to .env. NEVER commit .env, and never put key material in it.
# A raw private key here undercuts the entire "the agent never holds the key"
# claim and a judge will ask. KMS is not substitutable.

# --- shared -------------------------------------------------------------------
# X-Internal-Token on every service-to-service call (api-contracts.md §0).
INTERNAL_TOKEN=change-me-to-a-long-random-string

# --- service discovery --------------------------------------------------------
# Where each service reaches the others. These default to localhost, which is
# correct on one machine and WRONG the moment services are on separate hosts.
#
# A15 puts signer-service on its own instance behind its own security group, so
# any real deployment MUST set these to private IPs or private DNS names. Leave
# them unset there and policy-service quietly dials its own localhost, fails to
# connect, and the error looks exactly like signer-service being down.
#
# Read by policy-service (SIGNER_URL, LEDGER_URL, CHAIN_GATEWAY_URL).
# Use PRIVATE addresses — none of these should ever be publicly routable.
SIGNER_URL=http://localhost:4003
LEDGER_URL=http://localhost:4001
CHAIN_GATEWAY_URL=http://localhost:4004

# --- chain-gateway (:4004) ----------------------------------------------------
CHAIN_IDS=43113
RPC_URL_43113=https://api.avax-test.network/ext/bc/C/rpc
RPC_URL_43114=https://api.avax.network/ext/bc/C/rpc
RPC_TIMEOUT_MS=10000

# --- signer-service (:4003) ---------------------------------------------------
# The KMS key id or ARN. The ID is not secret, but never log it in full.
KMS_KEY_ID=
AWS_REGION=ap-southeast-1

# The custody proof. Derived from the KMS public key at boot and asserted
# character-for-character; the service refuses to start on mismatch.
# Set this from `scripts/setup-kms.sh` output, NOT by hand.
EXPECTED_SIGNER_ADDRESS=

# The chain this signer is allowed to sign for. A mismatch is SIGNER_WRONG_CHAIN.
SIGNER_CHAIN_ID=43113

# The immutable pinned map (A14). Loaded at boot, NEVER from a request.
# JSON: { "<mandateId>": { "settlementRecipient": "0x…", "hardMaxTotal": "30000000" } }
PINNED_MANDATES={}

# Dev/test only. When SIGNER_KEY_SOURCE=local the service signs with a local
# key instead of KMS — for offline signature-vector tests. It refuses to start
# in this mode unless ALLOW_LOCAL_KEY_SOURCE=true is also set.
SIGNER_KEY_SOURCE=kms
# ALLOW_LOCAL_KEY_SOURCE=true
# LOCAL_SIGNER_PRIVATE_KEY=

# --- agent-orchestrator (:4005) ------------------------------------------------
# Outbound service URLs. Defaults match SERVICE_PORTS on localhost; only set
# these for a non-local topology. No SIGNER_URL — the orchestrator must not be
# able to reach signer-service (C10, scripts/verify-signer-isolation.sh).
LEDGER_URL=http://localhost:4001
POLICY_URL=http://localhost:4002
CHAIN_GATEWAY_URL=http://localhost:4004

# The paying wallet card-gateway asks the MCP server to card-issue against.
# Must equal signer-service's EXPECTED_SIGNER_ADDRESS — the orchestrator never
# holds a key, it only names whose signature it's about to go ask for.
PAYING_WALLET_ADDRESS=

# Where the C7 poisoned-page fixtures are served (fixture-server.ts).
FIXTURE_PORT=4010
FIXTURE_BASE_URL=http://localhost:4010
# Checked-in merchant profiles define all permitted hosts, paths and selectors.
# They contain no credentials or card data.

# --- dashboard (:3000) ---------------------------------------------------------
AGENT_ORCHESTRATOR_URL=http://localhost:4005

# --- deploy (packages/contracts-sol) ------------------------------------------
# Optional, for `forge verify-contract`.
SNOWTRACE_API_KEY=
