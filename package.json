{
  "name": "straitsx-888",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:isolation": "tsx scripts/isolation-probe.ts",
    "dev:chain-gateway": "pnpm --filter @straitsx/chain-gateway dev",
    "dev:signer": "pnpm --filter @straitsx/signer-service dev",
    "dev:ledger": "pnpm --filter @straitsx/ledger-service dev",
    "dev:policy": "pnpm --filter @straitsx/policy-service dev",
    "dev:orchestrator": "pnpm --filter @straitsx/agent-orchestrator dev",
    "dev:fixtures": "pnpm --filter @straitsx/agent-orchestrator fixtures",
    "dev:dashboard": "pnpm --filter @straitsx/dashboard dev",
    "sol:test": "forge test --root packages/contracts-sol",
    "sol:build": "forge build --root packages/contracts-sol"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
