{
  "name": "straitsx-888",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:isolation": "./scripts/test-isolation.sh",
    "dev:chain-gateway": "pnpm --filter @straitsx/chain-gateway dev",
    "dev:signer": "pnpm --filter @straitsx/signer-service dev",
    "sol:test": "forge test --root packages/contracts-sol",
    "sol:build": "forge build --root packages/contracts-sol"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
